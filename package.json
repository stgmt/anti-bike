{
  "name": "anti-bike",
  "version": "0.1.0",
  "description": "Гейт для агентов: не дать написать то, что уже есть в проекте или библиотеке",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "test:watch": "node --test --watch --experimental-strip-types test/*.test.ts",
    "types": "tsc --noEmit",
    "check": "npm run types && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
